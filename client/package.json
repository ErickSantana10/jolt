{
  "name": "jolt-desktop",
  "private": true,
  "version": "2.4.0",
  "description": "Jolt — Voz, Vídeo Sincronizado e Transmissão 60 FPS",
  "author": "Erick Santana",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:start": "electron .",
    "electron:dist": "npm run build && electron-builder --win portable"
  },
  "build": {
    "appId": "com.ericksantana.jolt",
    "productName": "Jolt",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/icon.ico",
      "public/icon.png",
      "public/logo.jpg"
    ],
    "asarUnpack": [
      "electron/jolt-audio-capture.exe"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "portable": {
      "artifactName": "Jolt-Windows.exe"
    }
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "lucide-react": "^1.16.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "socket.io-client": "^4.8.3",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^45.2.0",
    "electron-builder": "^26.8.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.1"
  }
}
